@prefix setemp:  <https://example.org/setemp#> .
@prefix setempw: <https://example.org/setempw#> .
@prefix tempo:   <https://w3id.org/tempo> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix windowtype:  <https://example.org/windowtypescheme#> .
@prefix framematerial:  <https://example.org/framematerialscheme#> .
@prefix shapes: <http://example.org/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix burglarresistance: <https://example.org/burglarresistancescheme#> .
@prefix fireresistance: <https://example.org/fireresistancescheme#> .
@prefix jambextension: <https://example.org/jambextensionscheme#> .
@prefix openingdirection: <https://example.org/openingdirectionscheme#> .
@prefix rotationaldirection: <https://example.org/rotationaldirectionscheme#> .



# --- Window A ---
setempw:Window_A
    a setempw:Window ;
    setempw:Frame_Height [
        a setemp:QuantitativeValue ;
        qudt:numericValue "1200"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/MilliM> ;
    ] ;
    setempw:Thermal_Transmittance [
        a setemp:QuantitativeValue ;
        qudt:numericValue "2"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/W-PER-M2-K> ;
    ] ;
    setempw:Frame_Material framematerial:PVC ;
    setempw:Window_Type windowtype:Fixed_Window ;
    setempw:Cutting_Protection "Tempered Glass";
    setempw:Burglar_Resistance burglarresistance:Protection_Class_1 ;
    setempw:Exterior_Colour "White" ;
    setempw:Interior_Colour "White" ;
    setempw:Frame_Depth [
        a setemp:QuantitativeValue ;
        qudt:numericValue "200"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/MilliM> ;
    ] ;
    setempw:Exterior_Reveal_Depth [
        a setemp:QuantitativeValue ;
        qudt:numericValue "50"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/MilliM> ;
    ] ;
    setempw:Jamb_Extension_Groove jambextension:Top_Bottom ;
    setempw:Gross_Weight [
        a setemp:QuantitativeValue ;
        qudt:numericValue "60"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/KiloGM> ;
    ] ;
    setempw:Net_Weight [
        a setemp:QuantitativeValue ;
        qudt:numericValue "50"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/KiloGM> ;
    ] ;
    setempw:Opening_Width [
        a setemp:QuantitativeValue ;
        qudt:numericValue "1400"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/MilliM> ;
    ] ;
    setempw:Opening_Direction openingdirection:Outwards ;
    setempw:Light_Transmittance [
        a setemp:QuantitativeValue ;
        qudt:numericValue "0.7"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> ;
    ] ;
    setempw:Solar_Energy_Transmittance [
        a setemp:QuantitativeValue ;
        qudt:numericValue "0.7"^^xsd:decimal ;
        qudt:unit <http://qudt.org/vocab/unit/UNITLESS> ;
    ] ;
    setempw:Sound_Insulation "42 (-1;-4)" ;
    setempw:Rotational_Direction rotationaldirection:Left_Hand_Opening ;
    setempw:Fire_Resistance fireresistance:E_60 .


