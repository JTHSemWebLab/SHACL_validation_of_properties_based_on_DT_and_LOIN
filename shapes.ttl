#################################################################
# NOMINAL SHAPES (STRINGS)
#################################################################

# --- Protection against cutting ---
shapes:CuttingProtectionShape
    a sh:NodeShape ;
    sh:targetClass setempw:Window ;
    sh:property [
        sh:path setempw:Cutting_Protection ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] .

# --- Interior colour ---
shapes:InteriorColourShape
    a sh:NodeShape ;
    sh:targetClass setempw:Window ;
    sh:property [
        sh:path setempw:Interior_Colour ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:minLength 1 ;
    ] .

