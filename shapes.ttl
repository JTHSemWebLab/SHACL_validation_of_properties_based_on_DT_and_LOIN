@prefix setemp:  <https://example.org/setemp#> .
@prefix setempw: <https://example.org/setempw#> .
@prefix tempo:   <https://w3id.org/tempo> .
@prefix qudt:    <http://qudt.org/schema/qudt/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix windowtype:  <https://example.org/windowtypescheme#> .
@prefix framematerial:  <https://example.org/framematerialscheme#> .
@prefix shapes: <http://example.org/shapes/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix burglarresistance: <https://example.org/burglarresistancescheme#> .
@prefix fireresistance: <https://example.org/fireresistancescheme#> .
@prefix jambextension: <https://example.org/jambextensionscheme#> .
@prefix openingdirection: <https://example.org/openingdirectionscheme#> .
@prefix rotationaldirection: <https://example.org/rotationaldirectionscheme#> .

#################################################################
# QUANTITATIVE SHAPES (QUDT)
#################################################################

# --- Frame height ---
shapes:FrameHeightShape
    a sh:NodeShape ;
    sh:targetClass setempw:Window ;
    sh:property [
        sh:path setempw:Frame_Height ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class setemp:QuantitativeValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
            ] ;
        ] ;
    ] .

# --- Thermal transmittance ---
shapes:ThermalTransmittanceShape
    a sh:NodeShape ;
    sh:targetClass setempw:Window ;
    sh:property [
        sh:path setempw:Thermal_Transmittance ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:node [
            sh:class setemp:QuantitativeValue ;
            sh:property [
                sh:path qudt:numericValue ;
                sh:datatype xsd:decimal ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
            ] ;
            sh:property [
                sh:path qudt:unit ;
                sh:hasValue <http://qudt.org/vocab/unit/W-PER-M2-K> ;
            ] ;
        ] ;
    ] .

