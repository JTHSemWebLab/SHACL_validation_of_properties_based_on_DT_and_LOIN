#################################################################
# CONTROLLED VOCABULARY SHAPES (SKOS)
#################################################################

# --- Frame material ---
shapes:FrameMaterialShape
    a sh:NodeShape ;
    sh:targetClass setempw:Window ;
    sh:property [
        sh:path setempw:Frame_Material ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:property [
            sh:path skos:inScheme ;
            sh:hasValue framematerial:FrameMaterialScheme ;
        ] ;
    ] .

# --- Window type ---
shapes:WindowTypeShape
    a sh:NodeShape ;
    sh:targetClass setempw:Window ;
    sh:property [
        sh:path setempw:Window_Type ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class skos:Concept ;
        sh:property [
            sh:path skos:inScheme ;
            sh:hasValue windowtype:WindowTypeScheme ;
        ] ;
    ] .

