@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix fireresistance:  <https://example.org/fireresistancescheme#> .


#################################################################
# SCHEME DEFINITION
#################################################################

fireresistance:FireResistanceScheme
    a skos:ConceptScheme ;
    rdfs:comment "resistance to fire according to EN 13501-2"@en ;
    rdfs:label "Fire resistance classes"@sv .

#################################################################
# CONCEPTS
#################################################################

fireresistance:EI1_30
    a skos:Concept ;
    skos:inScheme fireresistance:FireResistanceScheme ;
    skos:notation "EI1 30" .

