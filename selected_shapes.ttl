@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/shapes/BurglarResistanceShape> a sh:NodeShape ;
    sh:property [ sh:class skos:Concept ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path <https://example.org/setempw#Burglar_Resistance> ;
            sh:property [ sh:hasValue <https://example.org/burglarresistancescheme#BurglarResistanceScheme> ;
                    sh:path skos:inScheme ] ] ;
    sh:targetClass <https://example.org/setempw#Window> .

<http://example.org/shapes/CuttingProtectionShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://example.org/setempw#Cutting_Protection> ] ;
    sh:targetClass <https://example.org/setempw#Window> .

<http://example.org/shapes/ExteriorColourShape> a sh:NodeShape ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:path <https://example.org/setempw#Exterior_Colour> ] ;
    sh:targetClass <https://example.org/setempw#Window> .

<http://example.org/shapes/ExteriorRevealDepthShape> a sh:NodeShape ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:node [ sh:class <https://example.org/setemp#QuantitativeValue> ;
                    sh:property [ sh:datatype xsd:decimal ;
                            sh:maxCount 1 ;
                            sh:minCount 1 ;
                            sh:path <http://qudt.org/schema/qudt/numericValue> ],
                        [ sh:hasValue <http://qudt.org/vocab/unit/MilliM> ;
                            sh:path <http://qudt.org/schema/qudt/unit> ] ] ;
            sh:path <https://example.org/setempw#Exterior_Reveal_Depth> ] ;
    sh:targetClass <https://example.org/setempw#Window> .

